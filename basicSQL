CREATE SEQUENCE seq_order_inquires
  START WITH 1
  INCREMENT BY 1
  NOCACHE
  NOCYCLE;
CREATE TABLE order_inquiries (
    id               NUMBER(10)      NOT NULL,
    order_id         NUMBER(10)      NOT NULL,
    inquiry_code     VARCHAR2(10)    NOT NULL,
    sent_by          NUMBER(10)      NOT NULL,
    customer_name    VARCHAR2(50 CHAR),
    customer_phone   VARCHAR2(20),
    customer_address VARCHAR2(200 CHAR),
    memo             VARCHAR2(200 CHAR),
    sent_at          DATE            DEFAULT SYSDATE NOT NULL,
    expires_at       DATE,
    used_flag        NUMBER(1)       DEFAULT 0 NOT NULL,
    CONSTRAINT pk_order_inquiries PRIMARY KEY (id),
    CONSTRAINT fk_inquiry_order   FOREIGN KEY (order_id) REFERENCES orders(id),
    CONSTRAINT fk_inquiry_sent_by FOREIGN KEY (sent_by)  REFERENCES users(id),
    CONSTRAINT ck_inquiry_used    CHECK (used_flag IN (0, 1))
);

CREATE SEQUENCE order_inquiries_seq START WITH 1 INCREMENT BY 1 NOCACHE;

CREATE INDEX idx_inquiry_order ON order_inquiries(order_id);
